{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eidolon-Echo",
  "version": "0.1.0",
  "identifier": "io.github.hughlfree.eidolonecho",
  "build": {
    "beforeDevCommand": "ROOT=\"$PWD\"; while [ \"$ROOT\" != \"/\" ]; do if [ -d \"$ROOT/apps/desktop/web\" ]; then cd \"$ROOT/apps/desktop/web\" && npm run dev; exit $?; fi; if [ -d \"$ROOT/web\" ] && [ -f \"$ROOT/src-tauri/tauri.conf.json\" ]; then cd \"$ROOT/web\" && npm run dev; exit $?; fi; ROOT=\"$(dirname \"$ROOT\")\"; done; echo 'web dir not found' >&2; exit 1",
    "beforeBuildCommand": "bash ./scripts/prepare-release-sidecar.sh",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Eidolon-Echo",
        "url": "index.html",
        "width": 189,
        "height": 196,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "chat",
        "title": "Eidolon-Echo Chat",
        "url": "chat.html",
        "width": 189,
        "height": 44,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true
      },
      {
        "label": "bubble",
        "title": "Eidolon-Echo Bubble",
        "url": "bubble.html",
        "width": 320,
        "height": 192,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true
      },
      {
        "label": "menu",
        "title": "Eidolon-Echo Panel",
        "url": "menu.html",
        "width": 76,
        "height": 140,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../backend/config/default.toml": "config/default.toml"
    },
    "externalBin": ["binaries/eidolon-echo-backend"]
  }
}
